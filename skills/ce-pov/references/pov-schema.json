{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "跨模型观点",
  "type": "object",
  "additionalProperties": false,
  "required": ["voice", "position", "reasoning", "evidence", "external_check", "mode", "movement", "final"],
  "properties": {
    "voice": {
      "type": "string",
      "minLength": 1,
      "description": "对等语音的简短标识；工作人员将其命名空间提供给提供者。"
    },
    "position": {
      "type": "string",
      "minLength": 1,
      "description": "采用等级、记录或方法底线、怀疑论结论或阻止状态。"
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "description": "该职位的简明推理，包括被阻止的原因。"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "带有 URL、file:line 或命名文档部分归属的简洁声明。"
      }
    },
    "external_check": {
      "type": "string",
      "enum": ["ran", "unavailable"]
    },
    "mode": {
      "type": "string",
      "enum": ["independent", "skeptic"]
    },
    "movement": {
      "type": "string",
      "enum": ["initial", "moved", "held"],
      "description": "初始位置，或者在协调过程中声音是移动还是保持。"
    },
    "final": {
      "type": "boolean",
      "description": "当位置是您的已解决答案时为 true（已解决的阻止判决有效）；当您尚未完成检查并且位置是占位符时为 false。"
    },
    "cross_model_route": { "type": "string" },
    "cross_model_target": { "type": "string" },
    "cross_model_harness": { "type": "string" },
    "serving_family": { "type": "string" },
    "model_requested": { "type": "string" },
    "model_actual": { "type": "string" },
    "independence_verified": { "type": "boolean" }
  }
}
